# Application
APP_NAME=DocCareerNest AI
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=127.0.0.1
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Local SQLite index
DATABASE_PATH=./data/doccareernest.db

# File scanning
HASH_CHUNK_SIZE=65536
MAX_SCAN_FILE_SIZE_MB=500
